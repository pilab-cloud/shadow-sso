{
  "name": "@pilab/shadow-sso",
  "version": "0.2.0",
  "description": "Official JavaScript/TypeScript helper for Shadow SSO. Includes a Google One Tap-style login card, iframe silent login, CSP/X-Frame-Options preflight, PKCE helpers and typed errors.",
  "license": "MIT",
  "author": "Progressive Innovation LAB <gyula@pilab.hu> (https://pilab.hu)",
  "contributors": [
    "Paal Gyula <gyula@pilab.hu>"
  ],
  "maintainers": [
    "Paal Gyula <gyula@pilab.hu>"
  ],
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pilab-cloud/shadow-sso.git"
  },
  "homepage": "https://github.com/pilab-cloud/shadow-sso#readme",
  "bugs": {
    "url": "https://github.com/pilab-cloud/shadow-sso/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build",
    "pack": "pnpm build && npm pack"
  },
  "keywords": [
    "sso",
    "oidc",
    "silent-login",
    "iframe",
    "pkce",
    "authentication",
    "single-sign-on",
    "typescript",
    "shadow-sso",
    "one-tap",
    "google-one-tap"
  ],
  "devDependencies": {
    "jsdom": "27.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
